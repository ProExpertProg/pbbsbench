ifeq (, $(shell which jemalloc-config))
JEMALLOC =
else
JEMALLOCLD = $(shell jemalloc-config --libdir)
JEMALLOC = -L$(JEMALLOCLD) -ljemalloc 
endif

# Extra flags can be given in the environment or as make CLI args.
# Note that make does not rebuild when only the flags change (make clean first).
EXTRA_CCFLAGS ?=
EXTRA_LDFLAGS ?=

CCFLAGS = -mcx16 -O2 -g -std=c++17 -DNDEBUG -I . $(EXTRA_CCFLAGS)
CLFLAGS = -ldl $(JEMALLOC) $(EXTRA_LDFLAGS)

OMPFLAGS = -DPARLAY_OPENMP -fopenmp
CILKFLAGS = -DPARLAY_CILKPLUS -fcilkplus
OPENCILKFLAGS = -DPARLAY_OPENCILK -fopencilk
PBBFLAGS = -DHOMEGROWN -pthread

ifdef OPENMP
DEFAULT_CC = g++
CFLAGS = $(OMPFLAGS) $(CCFLAGS)
LFLAGS = $(OMPFLAGS) $(CLFLAGS)

else ifdef OPENCILK
DEFAULT_CC = clang++
CFLAGS = $(OPENCILKFLAGS) $(CCFLAGS)
LFLAGS = $(OPENCILKFLAGS) $(CLFLAGS)

else ifdef CILK
DEFAULT_CC = g++
CFLAGS = $(CILKFLAGS) $(CCFLAGS)
LFLAGS = $(CILKFLAGS) $(CLFLAGS)

else
DEFAULT_CC = g++
CFLAGS = $(PBBFLAGS) $(CCFLAGS)
LFLAGS = $(PBBFLAGS) $(CLFLAGS)
endif

# The compiler can be overridden with CC=... (envvar or as a CLI arg)
# (make itself defines CC=cc, so a plain ?= would never apply).
ifeq ($(origin CC), default)
CC = $(DEFAULT_CC)
endif
